# Generate a long random token locally, then store ONLY its SHA-256 hash here.
# Example: printf '%s' 'your-random-token' | sha256sum
ROITH_API_TOKEN_SHA256=replace_with_64_character_sha256_hex

# Exact browser origin(s), comma-separated. Do not use *.
ROITH_ALLOWED_ORIGINS=https://YOUR-ROITH-PAGES-DOMAIN.pages.dev

# Private local storage. Use a dedicated unprivileged Linux service account.
ROITH_DATA_DIR=/var/lib/roith
ROITH_MAX_UPLOAD_BYTES=26214400
ROITH_JOB_TIMEOUT_SECONDS=120
ROITH_WORKER_IMAGE=localhost/roith-worker:1.0
ROITH_PODMAN_BIN=podman
ROITH_MAX_QUEUED_JOBS=10
ROITH_MAX_JOBS_PER_HOUR=20
ROITH_MAX_STORED_BYTES=5368709120
